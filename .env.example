# ==========================================
# RTI CONNECT – Environment Configuration
# ==========================================

# Database: PostgreSQL with pgvector extension support
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rticonnect?schema=public"

# Authentication: Auth.js / NextAuth
NEXTAUTH_SECRET="rti-connect-secret-key-32-chars-long!!"
NEXTAUTH_URL="http://localhost:3001"

# AI Intelligence Providers (Optional - Auto-detected)
# When set, the system connects directly to Google Gemini or OpenAI.
# When not set, the platform uses its high-fidelity built-in Development Deterministic Engine.
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# AI Engine Model Settings
AI_PROVIDER="auto" # auto | gemini | openai | local
SEMANTIC_SIMILARITY_THRESHOLD="0.35"
DEFAULT_STATUTORY_DEADLINE_DAYS="30"
